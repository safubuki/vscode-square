      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AllowDrop" Value="True" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <EventSetter Event="DragEnter" Handler="StoredPanelTab_DragEnter" />
      <EventSetter Event="DragLeave" Handler="StoredPanelTab_DragLeave" />
      <EventSetter Event="DragOver" Handler="StoredPanelTab_DragOver" />
      <EventSetter Event="Drop" Handler="StoredPanelTab_Drop" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="TabButtonRoot"
                  Height="{TemplateBinding Height}"
                  MinWidth="{TemplateBinding MinWidth}"
                  ClipToBounds="False"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
              <Border x:Name="TabButtonBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True" />
              <!-- 長い名前は「…」で省略する（全文は ToolTip 側で確認できる）。 -->
