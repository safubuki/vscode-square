                                         Text="名前"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <TextBox Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding PanelTitle, UpdateSourceTrigger=LostFocus}"
                                       Style="{StaticResource SettingsTextBoxStyle}"
                                       Margin="0,4,0,0" />

                              <TextBlock Grid.Row="2"
                                         Text="パス"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <TextBox Grid.Row="2"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Path, UpdateSourceTrigger=LostFocus}"
                                       Style="{StaticResource SettingsTextBoxStyle}"
                                       Margin="0,4,0,0" />

