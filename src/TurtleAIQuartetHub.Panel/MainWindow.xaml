                                       Text="{Binding ApplicationId, UpdateSourceTrigger=LostFocus}"
                                       ToolTip="vscode / antigravity / codex / claude / github-copilot / grok / gemini"
                                       Style="{StaticResource SettingsTextBoxStyle}" />
                              <Button Grid.Column="2"
                                      Content="空にする"
                                      Tag="{Binding}"
                                      Click="SettingsClearStoredPanelButton_Click"
                                      Style="{StaticResource StoredAssignButton}"
                                      Margin="8,0,0,0" />

                              <TextBlock Grid.Row="1"
                                         Text="名前"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <TextBox Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding PanelTitle, UpdateSourceTrigger=LostFocus}"
                                       Style="{StaticResource SettingsTextBoxStyle}"
                                       Margin="0,4,0,0" />

                              <TextBlock Grid.Row="2"
                                         Text="パス"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <TextBox Grid.Row="2"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding WorkspacePath, UpdateSourceTrigger=LostFocus}"
                                       Style="{StaticResource SettingsTextBoxStyle}"
                                       Margin="0,4,0,0" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Content="不整合を修復"
                        Click="RepairPanelStateButton_Click"
                        Style="{StaticResource BaseButton}"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        ToolTip="スロット表示の不整合を点検・修正（ウィンドウは閉じません）" />
                <Button Content="再検出"
                        Click="ReloadApplicationDetectionButton_Click"
                        Style="{StaticResource BaseButton}"
                        MinWidth="86"
                        Margin="0,0,8,0"
                        ToolTip="各アプリの起動可否を再判定" />
                <Button Content="ログを表示"
                        Click="ShowTodayLogButton_Click"
                        Style="{StaticResource BaseButton}"
                        MinWidth="96"
                        ToolTip="本日分の診断ログを表示" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right">
                <Button Content="パス設定を保存"
                        Click="SaveApplicationPathSettingsButton_Click"
                        Style="{StaticResource BaseButton}"
                        MinWidth="122"
                        Margin="0,0,8,0"
                        ToolTip="入力したパスを保存して反映" />
                <Button x:Name="CloseSettingsDialogButton"
                        Content="閉じる"
                        Click="CloseSettingsButton_Click"
                        Style="{StaticResource BaseButton}"
                        MinWidth="86" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="HelpOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#96090B0A"
            Panel.ZIndex="23">
      <Grid>
        <Border Width="486"
                MaxWidth="520"
                Padding="16"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="ヘルプ"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}" />
              <Button Grid.Column="1"
                      Content="X"
                      ToolTip="閉じる"
                      Click="CloseHelpButton_Click"
                      Style="{StaticResource ChromeButton}" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,12,0,0"
                          MaxHeight="430"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Padding="11"
                        Background="#102019"
                        BorderBrush="#315B43"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="CLI セットアップガイド"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Margin="0,5,0,0"
                               Text="CLI ごとにインストール方法と起動オプションを分けています。コマンドは表示専用で、この画面から実行されることはありません。"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Margin="0,5,0,0"
                               Text="IDE と Windows アプリは、各製品の公式サイトを参照してください。"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="10"
                        Background="#211715"
                        BorderBrush="#5E3A32"
                        BorderThickness="1"
                        CornerRadius="8">
                  <TextBlock Text="注意: 「自律実行の起動オプション」は承認確認を減らす、または権限を広げます。信頼できるワークスペースでのみ使用してください。"
                             TextWrapping="Wrap"
                             TextTrimming="None"
                             Foreground="#F2B7AF" />
                </Border>

                <Border Style="{StaticResource HelpCliCardStyle}">
                  <StackPanel>
                    <TextBlock Text="Codex CLI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="インストール"
                               Style="{StaticResource HelpSectionLabelStyle}" />
                    <TextBlock Text="Windows PowerShell（推奨）"
                               Style="{StaticResource HelpInstallMethodLabelStyle}"
                               Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="powershell -ExecutionPolicy ByPass -c &quot;irm https://chatgpt.com/codex/install.ps1 | iex&quot;" />
                    <TextBlock Text="npm"
                               Style="{StaticResource HelpInstallMethodLabelStyle}" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="npm install -g @openai/codex" />
                    <TextBlock Text="自律実行の起動オプション"
                               Style="{StaticResource HelpSectionLabelStyle}"
                               Foreground="#F2B7AF" />
                    <TextBox Style="{StaticResource HelpAutonomousCommandTextBoxStyle}"
                             Text="codex --ask-for-approval never --sandbox workspace-write" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCliCardStyle}">
                  <StackPanel>
                    <TextBlock Text="GitHub Copilot CLI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="インストール"
                               Style="{StaticResource HelpSectionLabelStyle}" />
                    <TextBlock Text="Windows（推奨）"
                               Style="{StaticResource HelpInstallMethodLabelStyle}"
                               Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="winget install GitHub.Copilot" />
                    <TextBlock Text="npm"
                               Style="{StaticResource HelpInstallMethodLabelStyle}" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="npm install -g @github/copilot" />
                    <TextBlock Text="自律実行の起動オプション"
                               Style="{StaticResource HelpSectionLabelStyle}"
                               Foreground="#F2B7AF" />
                    <TextBox Style="{StaticResource HelpAutonomousCommandTextBoxStyle}"
                             Text="copilot --allow-all" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCliCardStyle}">
                  <StackPanel>
                    <TextBlock Text="Gemini CLI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="インストール"
                               Style="{StaticResource HelpSectionLabelStyle}" />
                    <TextBlock Text="npm"
                               Style="{StaticResource HelpInstallMethodLabelStyle}"
                               Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="npm install -g @google/gemini-cli" />
                    <TextBlock Text="自律実行の起動オプション"
                               Style="{StaticResource HelpSectionLabelStyle}"
                               Foreground="#F2B7AF" />
                    <TextBox Style="{StaticResource HelpAutonomousCommandTextBoxStyle}"
                             Text="gemini --approval-mode=yolo" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCliCardStyle}">
                  <StackPanel>
                    <TextBlock Text="Claude Code"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="インストール"
                               Style="{StaticResource HelpSectionLabelStyle}" />
                    <TextBlock Text="Windows PowerShell（推奨）"
                               Style="{StaticResource HelpInstallMethodLabelStyle}"
                               Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="irm https://claude.ai/install.ps1 | iex" />
                    <TextBlock Text="Windows コマンドプロンプト"
                               Style="{StaticResource HelpInstallMethodLabelStyle}" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="curl -fsSL https://claude.ai/install.cmd -o install.cmd &amp;&amp; install.cmd &amp;&amp; del install.cmd" />
                    <TextBlock Text="npm"
                               Style="{StaticResource HelpInstallMethodLabelStyle}" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="npm install -g @anthropic-ai/claude-code" />
                    <TextBlock Text="自律実行の起動オプション"
                               Style="{StaticResource HelpSectionLabelStyle}"
                               Foreground="#F2B7AF" />
                    <TextBox Style="{StaticResource HelpAutonomousCommandTextBoxStyle}"
                             Text="claude --permission-mode bypassPermissions" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCliCardStyle}">
                  <StackPanel>
                    <TextBlock Text="Grok Build CLI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="インストール"
                               Style="{StaticResource HelpSectionLabelStyle}" />
                    <TextBlock Text="Windows PowerShell"
                               Style="{StaticResource HelpInstallMethodLabelStyle}"
                               Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="irm https://x.ai/cli/install.ps1 | iex" />
                    <TextBlock Text="Git Bash / WSL"
                               Style="{StaticResource HelpInstallMethodLabelStyle}" />
                    <TextBox Style="{StaticResource HelpCommandTextBoxStyle}"
                             Text="curl -fsSL https://x.ai/cli/install.sh | bash" />
                    <TextBlock Text="自律実行の起動オプション"
                               Style="{StaticResource HelpSectionLabelStyle}"
                               Foreground="#F2B7AF" />
                    <TextBox Style="{StaticResource HelpAutonomousCommandTextBoxStyle}"
                             Text="grok --always-approve" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
              <Button x:Name="CloseHelpDialogButton"
                      Content="閉じる"
                      Click="CloseHelpButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="96" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="LogOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#96090B0A"
            Panel.ZIndex="24">
      <Grid>
        <!-- ダイアログの最大高さをウィンドウの実クライアント高に追従させ、上下マージン分だけ
             縮めて常に画面内へ収める。これがないと、オーバーレイの親（RootLayoutGrid の Auto 行）が
             コンテンツに合わせて伸び、ダイアログがウィンドウ高（既定 535）を超えて下端のボタン行が
             切れていた。本文(*) が伸縮し、ボタン行(Auto) は常に下端に残る。 -->
        <Border MaxWidth="760"
                Margin="14"
                Padding="16"
                MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SubtractConverter}, ConverterParameter=44}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
          <!-- ヘッダー(Auto) / ログ本文(*) / ボタン行(Auto) の 3 段。本文だけが伸縮し、
               ボタン行は常に下端に残る。ログが長くても本文側に縦スクロールが出るだけで、
               コピー等のボタンが画面外へ押し出されないようにする。 -->
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="本日のログ"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="LogFilePathText"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="X"
                      ToolTip="閉じる"
                      Click="CloseLogButton_Click"
                      Style="{StaticResource ChromeButton}" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="2"
                    Background="#111815"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
              <TextBox x:Name="LogContentTextBox"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       BorderThickness="0"
                       Background="Transparent"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
              <Button Content="コピー"
                      Click="CopyLogButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="86"
                      Margin="0,0,8,0"
                      ToolTip="表示中の本日分ログをクリップボードへコピー" />
              <Button Content="再読み込み"
                      Click="ReloadLogButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="96"
                      Margin="0,0,8,0"
                      ToolTip="本日分を最新の内容で読み直し" />
              <Button Content="ファイルを開く"
                      Click="OpenLogFileButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="110"
                      Margin="0,0,8,0"
                      ToolTip="panel.log を既定アプリで開く（不可ならフォルダを開く）" />
              <Button Content="閉じる"
                      Click="CloseLogButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="86" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="MaintenanceResultOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#96090B0A"
            Panel.ZIndex="25">
      <Grid>
        <Border Width="392"
                MaxWidth="440"
                Padding="16"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="MaintenanceResultTitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" />

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="10,8"
                    Background="#1D2420"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
              <TextBlock x:Name="MaintenanceResultDetailText"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Foreground="{StaticResource MutedTextBrush}" />
            </Border>

            <StackPanel Grid.Row="2"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
              <Button Content="OK"
                      Click="CloseMaintenanceResultButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="86" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
